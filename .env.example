# Flask Configuration
FLASK_ENV=development
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# Database Configuration
# Local SQLite fallback is used if DATABASE_URL is not set.
# For production PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/swiftlink_db

# Security Settings
# SESSION_COOKIE_SECURE=True
